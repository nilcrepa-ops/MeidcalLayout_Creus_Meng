<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Typography ===== -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">29sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">36dp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Button" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
